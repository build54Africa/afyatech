<!-- home.ejs -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AfyaTech - Home</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    body {
      font-family: Arial, sans-serif;
      line-height: 1.6;
      background-color: #f4f4f9;
      color: #333;
    }

    /* Navbar styles */
    .navbar {
      background: #0078d7;
      color: #fff;
      padding: 0;
      box-shadow: 0 2px 6px rgba(0,0,0,0.1);
      position: sticky;
      top: 0;
      z-index: 1000;
    }

    .nav-container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 12px 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .logo {
      font-size: 22px;
      font-weight: 700;
      letter-spacing: 0.5px;
    }

    .nav-links {
      display: flex;
      list-style: none;
      align-items: center;
      transition: max-height 0.3s ease-in-out;
    }

    .nav-links li {
      margin-left: 25px;
    }

    .nav-links a {
      color: #fff;
      text-decoration: none;
      font-weight: 500;
      padding: 8px 12px;
      border-radius: 4px;
      transition: background 0.2s ease-in-out, color 0.2s ease-in-out;
    }

    .nav-links a:hover,
    .nav-links a:focus {
      background: rgba(255,255,255,0.15);
      color: #fff;
    }

    /* Mobile menu toggle */
    .menu-toggle {
      display: none;
      cursor: pointer;
      font-size: 28px;
      user-select: none;
      transition: transform 0.2s ease;
    }
    .menu-toggle.active {
      transform: rotate(90deg);
    }

    /* Hero section */
    .hero {
      text-align: center;
      padding: 80px 20px;
      background: #fff;
      margin: 20px;
      border-radius: 5px;
      box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
    }
    .hero h1 {
      color: #0078d7;
      font-size: 2.5em;
      margin-bottom: 20px;
    }
    .hero p {
      font-size: 1.2em;
      margin-bottom: 30px;
      color: #555;
    }

    /* Buttons */
    .btn {
      display: inline-block;
      padding: 12px 24px;
      margin: 10px;
      border-radius: 4px;
      text-decoration: none;
      font-weight: bold;
      cursor: pointer;
      border: none;
      font-size: 16px;
    }
    .btn-login {
      background: #28a745;
      color: #fff;
    }
    .btn-register {
      background: #0078d7;
      color: #fff;
    }
    .btn:hover {
      opacity: 0.9;
    }

    /* Features section */
    .features {
      display: flex;
      justify-content: space-around;
      flex-wrap: wrap;
      padding: 40px 20px;
      background: #fff;
      margin: 20px;
      border-radius: 5px;
      box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
    }
    .feature {
      text-align: center;
      padding: 20px;
      max-width: 300px;
    }
    .feature h3 {
      color: #0078d7;
      margin-bottom: 10px;
    }

    /* Footer */
    .footer {
      text-align: center;
      padding: 20px;
      background: #333;
      color: #fff;
      margin-top: 20px;
    }

    /* Responsive navbar */
    @media (max-width: 768px) {
      .nav-links {
        position: absolute;
        top: 60px;
        left: 0;
        right: 0;
        background: #0078d7;
        flex-direction: column;
        align-items: flex-start;
        padding: 10px 0;
        max-height: 0;
        overflow: hidden;
      }
      .nav-links.active {
        max-height: 400px; /* enough to show all links */
      }
      .nav-links li {
        margin: 10px 20px;
        width: 100%;
      }
      .nav-links a {
        display: block;
        width: 100%;
      }
      .menu-toggle {
        display: block;
      }
    }
  </style>
</head>
<body>
  <!-- Navbar -->
  <nav class="navbar">
    <div class="nav-container">
      <div class="logo">AfyaTech</div>
      <div class="menu-toggle" aria-label="Toggle menu">☰</div>
      <ul class="nav-links">
        <li><a href="/patients">Patients</a></li>
        <li><a href="/form">Form</a></li>
        <li><a href="/ai">AI</a></li>
    
      </ul>
    </div>
  </nav>

  <!-- Hero Section -->
  <section class="hero">
    <h1>Welcome to AfyaTech</h1>
    <p>Your trusted partner in patient impact and healthcare management.</p>
    
  </section>

  <!-- Features Section -->
  <section class="features">
    <div class="feature">
      <h3>Patient Records</h3>
      <p>Easily manage and update patient records with our intuitive interface.</p>
    </div>
    <div class="feature">
      <h3>Impact Tracking</h3>
      <p>Track patient outcomes and improve healthcare delivery.</p>
    </div>
    <div class="feature">
      <h3>Secure & Reliable</h3>
      <p>Your data is safe with our secure and reliable platform.</p>
    </div>
  </section>

  <!-- Footer -->
  <footer class="footer">
    <p>&copy; 2025 AfyaTech. All rights reserved.</p>
  </footer>

  <script>
    const toggle = document.querySelector('.menu-toggle');
    const links = document.querySelector('.nav-links');

    toggle.addEventListener('click', () => {
      links.classList.toggle('active');
      toggle.classList.toggle('active');
    });
  </script>
</body>
</html>
