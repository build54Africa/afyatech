<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AfyaTech - Home</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    body {
      font-family: Arial, sans-serif;
      line-height: 1.6;
      margin: 0;
      padding: 0;
      background-color: #f4f4f9;
      color: #333;
    }
    /* Navbar styles */
    .navbar {
      background: #0078d7;
      color: #fff;
      padding: 10px 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .logo {
      font-size: 20px;
      font-weight: bold;
    }
    .nav-links {
      display: flex;
      list-style: none;
    }
    .nav-links li {
      margin-left: 20px;
    }
    .nav-links a {
      color: #fff;
      text-decoration: none;
      font-weight: 500;
    }
    .nav-links a:hover {
      text-decoration: underline;
    }
    .menu-toggle {
      display: none;
      cursor: pointer;
      font-size: 24px;
    }
    /* Hero section */
    .hero {
      text-align: center;
      padding: 80px 20px;
      background: #fff;
      margin: 20px;
      border-radius: 5px;
      box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
    }
    .hero h1 {
      color: #0078d7;
      font-size: 2.5em;
      margin-bottom: 20px;
    }
    .hero p {
      font-size: 1.2em;
      margin-bottom: 30px;
      color: #555;
    }
    /* Buttons */
    .btn {
      display: inline-block;
      padding: 12px 24px;
      margin: 10px;
      border-radius: 4px;
      text-decoration: none;
      font-weight: bold;
      cursor: pointer;
      border: none;
      font-size: 16px;
    }
    .btn-login {
      background: #28a745;
      color: #fff;
    }
    .btn-register {
      background: #0078d7;
      color: #fff;
    }
    .btn:hover {
      opacity: 0.9;
    }
    /* Features section */
    .features {
      display: flex;
      justify-content: space-around;
      flex-wrap: wrap;
      padding: 40px 20px;
      background: #fff;
      margin: 20px;
      border-radius: 5px;
      box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
    }
    .feature {
      text-align: center;
      padding: 20px;
      max-width: 300px;
    }
    .feature h3 {
      color: #0078d7;
      margin-bottom: 10px;
    }
    /* Footer */
    .footer {
      text-align: center;
      padding: 20px;
      background: #333;
      color: #fff;
      margin-top: 20px;
    }
    /* Responsive navbar */
    @media (max-width: 768px) {
      .nav-links {
        display: none;
        flex-direction: column;
        width: 100%;
        position: absolute;
        top: 50px;
        left: 0;
        background: #0078d7;
        padding: 10px;
      }
      .nav-links.active {
        display: flex;
      }
      .nav-links li {
        margin: 10px 0;
      }
      .menu-toggle {
        display: block;
      }
    }
  </style>
</head>
<body>
  <!-- Navbar -->
  <nav class="navbar">
    <div class="logo">AfyaTech</div>
    <div class="menu-toggle">☰</div>
    <ul class="nav-links">
     
    <li><a href="/patients">patients</a></li>
        <li><a href="/form">Form</a></li>
        <li><a href="/ai">Ai</a></li>
      <!--<li><a href="/about">Anslysis</a></li>-->
      <li><a href="/contact">Contact</a></li>
    </ul>
  </nav>

  <!-- Hero Section -->
  <section class="hero">
    <h1>Welcome to AfyaTech</h1>
    <p>Your trusted partner in patient impact and healthcare management.</p>
    <a href="/login" class="btn btn-login">Login</a>
    <a href="/register" class="btn btn-register">Register</a>
  </section>

  <!-- Features Section -->
  <section class="features">
    <div class="feature">
      <h3>Patient Records</h3>
      <p>Easily manage and update patient records with our intuitive interface.</p>
    </div>
    <div class="feature">
      <h3>Impact Tracking</h3>
      <p>Track patient outcomes and improve healthcare delivery.</p>
    </div>
    <div class="feature">
      <h3>Secure & Reliable</h3>
      <p>Your data is safe with our secure and reliable platform.</p>
    </div>
  </section>

  <!-- Footer -->
  <footer class="footer">
    <p>&copy; 2025 AfyaTech. All rights reserved.</p>
  </footer>

  <script>
    // Toggle mobile menu
    document.querySelector('.menu-toggle').addEventListener('click', function() {
      document.querySelector('.nav-links').classList.toggle('active');
    });
  </script>
</body>
</html>
