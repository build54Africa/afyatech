<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AfyaTech - Patient Impact Records</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      line-height: 1.6;
      margin: 0;
      padding: 20px;
      background-color: #f4f4f9;
      color: #333;
    }
    .container {
      max-width: 1200px;
      margin: 0 auto;
      background: #fff;
      padding: 20px;
      border-radius: 5px;
      box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
    }
    h1 {
      text-align: center;
      color: #0078d7;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 20px;
    }
    th, td {
      padding: 12px;
      text-align: left;
      border-bottom: 1px solid #ddd;
    }
    th {
      background-color: #0078d7;
      color: #fff;
    }
    tr:nth-child(even) {
      background-color: #f2f2f2;
    }
    tr:hover {
      background-color: #e9e9e9;
    }
    .add-patient-btn {
      display: block;
      width: 200px;
      margin: 20px auto;
      padding: 10px;
      background-color: #0078d7;
      color: #fff;
      text-align: center;
      text-decoration: none;
      border-radius: 5px;
      font-weight: bold;
    }
    .add-patient-btn:hover {
      background-color: #005fa3;
    }
    .tag {
      display: inline-block;
      background: #e9ecef;
      padding: 3px 8px;
      border-radius: 10px;
      margin: 2px;
      font-size: 12px;
    }
  </style>
</head>
<body>
  <div class="container">
    <h1>Patient Impact Records</h1>

    <a href="/" class="add-patient-btn">Add New Patient</a>

    <table>
      <thead>
        <tr>
          <th>ID</th>
          <th>Name</th>
          <th>Age</th>
          <th>Gender</th>
          <th>Diagnosis</th>
          <th>Symptoms</th>
          <th>Allergies</th>
          <th>Follow-Up</th>
          <th>Impact Notes</th>
        </tr>
      </thead>
      <tbody>
        <% if (patients.length > 0) { %>
          <% patients.forEach(patient => { %>
            <tr>
              <td><%= patient.id %></td>
              <td><%= patient.name %></td>
              <td><%= patient.age %></td>
              <td><%= patient.gender %></td>
              <td><%= patient.diagnosis %></td>
              <td>
                <% if (patient.symptoms && patient.symptoms.length > 0) { %>
                  <% patient.symptoms.forEach(symptom => { %>
                    <span class="tag"><%= symptom %></span>
                  <% }); %>
                <% } else { %>
                  None
                <% } %>
              </td>
              <td>
                <% if (patient.allergies && patient.allergies.length > 0) { %>
                  <% patient.allergies.forEach(allergy => { %>
                    <span class="tag"><%= allergy %></span>
                  <% }); %>
                <% } else { %>
                  None
                <% } %>
              </td>
              <td><%= patient.follow_up_date ? new Date(patient.follow_up_date).toLocaleDateString() : 'None' %></td>
              <td><%= patient.impact_notes || 'None' %></td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr>
            <td colspan="9" style="text-align: center;">No patient records found.</td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</body>
</html>
