<!-- views/ai.ejs -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>AfyaTech - AI Report Generator</title>
  <style>
    body {
      font-family: 'Segoe UI', Arial, sans-serif;
      background: #f4f6fb;
      margin: 0;
      padding: 40px 10px;
      color: #333;
    }
    .container {
      max-width: 700px;
      margin: 0 auto;
      background: #fff;
      padding: 30px;
      border-radius: 12px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.08);
      animation: fadeIn 0.4s ease-in-out;
    }
    @keyframes fadeIn {
      from {opacity:0; transform: translateY(10px);}
      to {opacity:1; transform: translateY(0);}
    }
    h1 {
      text-align: center;
      color: #0078d7;
      margin-bottom: 25px;
    }

    /* Back button */
    .back-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: #f0f0f0;
      color: #333;
      padding: 8px 14px;
      border-radius: 30px;
      border: none;
      cursor: pointer;
      font-size: 14px;
      font-weight: 600;
      text-decoration: none;
      transition: all 0.2s ease-in-out;
      margin-bottom: 15px;
    }
    .back-btn:hover {
      background: #e2e2e2;
      transform: translateX(-3px);
    }

    .form-group {
      margin-bottom: 15px;
    }
    label {
      display: block;
      margin-bottom: 6px;
      font-weight: 600;
      color: #555;
    }
    select, input[type="date"] {
      width: 100%;
      padding: 10px;
      border: 1px solid #ddd;
      border-radius: 6px;
      font-size: 15px;
      transition: border 0.2s ease-in-out;
    }
    select:focus, input[type="date"]:focus {
      outline: none;
      border-color: #0078d7;
    }

    button[type="submit"] {
      background: linear-gradient(90deg, #0078d7, #005fa3);
      color: #fff;
      border: none;
      font-size: 16px;
      font-weight: 600;
      border-radius: 8px;
      cursor: pointer;
      padding: 12px 20px;
      display: block;
      width: 100%;
      transition: opacity 0.2s ease-in-out;
    }
    button[type="submit"]:hover {
      opacity: 0.9;
    }

    /* Result */
    #reportResult {
      margin-top: 20px;
      padding: 15px;
      border: 1px solid #ddd;
      border-radius: 8px;
      background: #f9f9f9;
      white-space: pre-wrap;
      min-height: 60px;
    }

    /* Loading spinner */
    .spinner {
      display: inline-block;
      width: 24px;
      height: 24px;
      border: 3px solid #ccc;
      border-top: 3px solid #0078d7;
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
      vertical-align: middle;
      margin-right: 8px;
    }
    @keyframes spin {
      0% {transform: rotate(0deg);}
      100% {transform: rotate(360deg);}
    }
  </style>
</head>
<body>
  <div class="container">
    <!-- Back Button -->
    <button id="backBtn" class="back-btn" type="button">
      ← Back
    </button>

    <h1>AI Report Generator</h1>

    <form id="reportForm" aria-label="AI report form">
      <div class="form-group">
        <label for="patientId">Select Patient:</label>
        <select id="patientId" name="patientId" required>
          <option value="">Select a Patient</option>
          <% patients.forEach(patient => { %>
            <option value="<%= patient._id || patient.id %>"><%= patient.name %></option>
          <% }); %>
        </select>
      </div>

      <div class="form-group">
        <label for="startDate">Start Date:</label>
        <input type="date" id="startDate" name="startDate" required>
      </div>

      <div class="form-group">
        <label for="endDate">End Date:</label>
        <input type="date" id="endDate" name="endDate" required>
      </div>

      <button type="submit" id="generateBtn">Generate Report</button>
    </form>

    <div id="reportResult" role="region" aria-live="polite"></div>
  </div>

  <script>
    // Back button: try history.back(), fallback to /patients
    document.getElementById('backBtn').addEventListener('click', () => {
      if (window.history.length > 1) {
        window.history.back();
        setTimeout(() => { window.location.href = '/patients'; }, 300);
      } else {
        window.location.href = '/patients';
      }
    });

    const reportForm = document.getElementById('reportForm');
    const reportResult = document.getElementById('reportResult');
    const generateBtn = document.getElementById('generateBtn');

    reportForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const patientId = document.getElementById('patientId').value;
      const startDate = document.getElementById('startDate').value;
      const endDate = document.getElementById('endDate').value;

      // Loading state
      generateBtn.disabled = true;
      generateBtn.textContent = 'Generating...';
      reportResult.innerHTML = `<span class="spinner"></span> Generating report...`;

      try {
        const response = await fetch('/api/patient/report', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ patientId, startDate, endDate }),
        });

        const data = await response.json();

        if (response.ok) {
          reportResult.textContent = data.report;
        } else {
          reportResult.textContent = `Error: ${data.error || 'Unknown error'}`;
        }
      } catch (error) {
        reportResult.textContent = 'Failed to generate report.';
        console.error('Report error:', error);
      } finally {
        generateBtn.disabled = false;
        generateBtn.textContent = 'Generate Report';
      }
    });
  </script>
</body>
</html>
